# Aegis dashboard configuration.
#
# Copy to .env.local and fill in the addresses of your deployment. There are no
# defaults for contract addresses: a dashboard pointed at the wrong contract
# would show a treasury that is not yours, so an unset address is an error the
# app reports rather than a value it guesses.
#
# ./scripts/sync-web-env.sh writes this file for you from the deployment record
# produced by the deploy script.

# --- Chain ---------------------------------------------------------------

# Flare Coston2.
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_EXPLORER_URL=https://coston2-explorer.flare.network

# --- Aegis contracts -----------------------------------------------------

NEXT_PUBLIC_POLICY_ENGINE_ADDRESS=
NEXT_PUBLIC_TREASURY_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYMENT_CONTROLLER_ADDRESS=

# The block the contracts were deployed in. The audit log never scans below it,
# because there is nothing there.
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# --- XRPL ----------------------------------------------------------------

# XRPL Testnet JSON-RPC, used for treasury balances and the current ledger
# index. Read-only: the dashboard never submits an XRPL transaction.
NEXT_PUBLIC_XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
NEXT_PUBLIC_XRPL_EXPLORER_URL=https://testnet.xrpl.org

# --- Event log scanning --------------------------------------------------

# The public Coston2 RPC refuses an eth_getLogs range wider than 30 blocks, so
# the audit log is fetched in chunks. Point NEXT_PUBLIC_RPC_URL at an archive
# node without that cap and raise this to pull the whole history in one call.
NEXT_PUBLIC_LOG_CHUNK_BLOCKS=30

# How far back the audit log scans from the current head, in blocks. Coston2
# produces a block roughly every 1.8s, so 4000 blocks is about two hours. The
# dashboard always states the block it scanned back to, so a bounded scan is
# visible rather than mistaken for a complete history.
NEXT_PUBLIC_LOG_LOOKBACK_BLOCKS=4000
